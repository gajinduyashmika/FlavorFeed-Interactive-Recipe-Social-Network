{
  "name": "flavorfeed-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FlavorFeed - Interactive Recipe Social Network",
  "type": "module",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && node seed/seedData.js",
    "test:e2e": "cd backend && node test_e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": ["recipe", "social-network", "mern", "foodies"],
  "author": "FlavorFeed Team",
  "license": "MIT"
}
